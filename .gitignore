# Dependencies
node_modules/

# Internal specs, plans, and store submission workflow (private)
docs/
store/

# Distributable packages — regenerate with `npm run package`
dist/

# Captured / generated build pipeline data (regeneratable; not source code)
tools/capture/
tools/analysis/
tools/bundle/chunks/
tools/bundle/translations/
tools/bundle/extracted.json
tools/bundle/manifest.json
tools/bundle/new-zones.json
tools/all-chunk-strings.txt
tools/all-strings.txt
tools/hu-strings.txt
tools/rendered-strings.txt
tools/crawl-log.txt
tools/diagnostic-output.json

# CRX signing keys. The extension ID is derived from the key, so a leaked key lets
# anyone publish an update AS this extension — and it can never be re-issued.
*.pem
crx-key*

# Editor / OS
.idea/
.vscode/
.DS_Store
*.log
